    "panel-10": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "bfofjfrzc16o0a"
                    },
                    "group": "grafana-postgresql-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "dataset": "carburants",
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "SELECT s.enseigne, s.ville, r.prix\nFROM Releve_prix r\nJOIN Station s   ON s.id_station   = r.id_station\nJOIN Carburant c ON c.id_carburant = r.id_carburant\nWHERE c.nom_carburant = 'Gazole'\n  AND r.prix < (\n        SELECT AVG(r2.prix)\n        FROM Releve_prix r2\n        JOIN Carburant c2 ON c2.id_carburant = r2.id_carburant\n        WHERE c2.nom_carburant = 'Gazole'\n      )\n  AND s.id_station NOT IN (\n        SELECT ru.id_station\n        FROM Rupture ru\n        JOIN Carburant c3 ON c3.id_carburant = ru.id_carburant\n        WHERE c3.nom_carburant = 'Gazole'\n          AND ru.date_fin IS NULL\n      )\n  AND s.id_station IN (\n        SELECT h.id_station\n        FROM Horaire h\n        WHERE h.jour = 'Lundi'\n      )\nORDER BY r.prix;",
                      "sql": {
                        "columns": [
                          {
                            "parameters": [],
                            "type": "function"
                          }
                        ],
                        "groupBy": [
                          {
                            "property": {
                              "type": "string"
                            },
                            "type": "groupBy"
                          }
                        ],
                        "limit": 50
                      }
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
